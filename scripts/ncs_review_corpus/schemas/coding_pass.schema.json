{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "coding_pass",
    "source_documents_sha256",
    "article_card",
    "episodes",
    "issues",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "calibration_id": {
      "enum": ["CAL-D01", "CAL-D02", "CAL-D03", "CAL-E01", "CAL-E02", "CAL-E03"]
    },
    "coding_pass": {"enum": ["A", "B"]},
    "source_documents_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "article_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_problem_zh",
        "computational_significance_zh",
        "contribution_zh",
        "method_zh",
        "data_or_benchmarks_zh",
        "validation_zh",
        "principal_findings_zh",
        "boundaries_zh",
        "reproducibility_zh",
        "public_decision_signal"
      ],
      "properties": {
        "research_problem_zh": {"type": "string"},
        "computational_significance_zh": {"type": "string"},
        "contribution_zh": {"type": "string"},
        "method_zh": {"type": "string"},
        "data_or_benchmarks_zh": {"type": "string"},
        "validation_zh": {"type": "string"},
        "principal_findings_zh": {"type": "string"},
        "boundaries_zh": {"type": "string"},
        "reproducibility_zh": {"type": "string"},
        "public_decision_signal": {
          "enum": ["EXPLICIT_PUBLIC", "CONDITIONAL_PUBLIC", "NO_PUBLIC_DECISION", "STATUS_ONLY", "UNKNOWN"]
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id", "episode_kind", "round_label", "roles_present",
          "summary_zh", "issue_ids", "linkage_confidence"
        ],
        "properties": {
          "episode_id": {"type": "string"},
          "episode_kind": {
            "enum": ["REVIEW_ROUND", "EDITORIAL_ROUND", "AUTHOR_RESPONSE_ROUND", "MIXED", "UNKNOWN"]
          },
          "round_label": {"type": "string"},
          "roles_present": {
            "type": "array",
            "items": {"enum": ["EDITOR", "REVIEWER", "AUTHOR", "PUBLISHER_META", "UNKNOWN"]}
          },
          "summary_zh": {"type": "string"},
          "issue_ids": {"type": "array", "items": {"type": "string"}},
          "linkage_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id", "episode_id", "actor_role", "issue_type",
          "concern_domain", "requested_action", "issue_summary_zh",
          "response_status", "response_summary_zh", "impact_weight",
          "impact_rationale_zh", "evidence", "inductive_tags",
          "minimum_response_zh", "strong_evidence_supplement_zh",
          "supported_claims_zh", "unsupported_or_unobserved_claims_zh",
          "cost_level", "cost_basis_zh", "stop_conditions_zh"
        ],
        "properties": {
          "issue_id": {"type": "string"},
          "episode_id": {"type": "string"},
          "actor_role": {"enum": ["EDITOR", "REVIEWER", "AUTHOR", "UNKNOWN"]},
          "issue_type": {
            "enum": ["CONCERN", "REQUEST", "QUESTION", "PRAISE", "CONDITION", "DECISION_SIGNAL", "RESPONSE_ONLY"]
          },
          "concern_domain": {
            "enum": [
              "NOVELTY_SIGNIFICANCE", "SCOPE_POSITIONING", "CORRECTNESS_THEORY",
              "METHOD_MODEL", "DATA_PROVENANCE", "EXPERIMENT_VALIDATION",
              "STATISTICS_UNCERTAINTY", "BASELINE_COMPARATOR", "REPRODUCIBILITY",
              "CLARITY_FIGURES", "ETHICS_COMPLIANCE", "WRITING_FORMAT", "OTHER"
            ]
          },
          "requested_action": {
            "enum": [
              "CLARIFY", "TEXT_EDIT", "CORRECT_ERROR", "NEW_ANALYSIS",
              "NEW_EXPERIMENT", "NEW_BASELINE", "ROBUSTNESS_CHECK", "DATA_SOURCE",
              "CODE_REPRODUCTION", "SCOPE_REDUCTION", "NO_ACTION_EXPLICIT", "UNKNOWN"
            ]
          },
          "issue_summary_zh": {"type": "string"},
          "response_status": {
            "enum": [
              "NO_RESPONSE", "ACKNOWLEDGED_ONLY", "CLARIFIED", "PARTIAL",
              "FULLY_ADDRESSED", "CONTRADICTED", "DEFERRED", "DECLINED_WITH_REASON",
              "UNRESOLVED", "NOT_APPLICABLE"
            ]
          },
          "response_summary_zh": {"type": "string"},
          "impact_weight": {"type": "integer", "minimum": 0, "maximum": 4},
          "impact_rationale_zh": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["grade", "document_id", "paragraph_id", "page_number", "quote"],
              "properties": {
                "grade": {"enum": ["JPR", "PPR", "CPR", "VCO", "STATUS_ONLY"]},
                "document_id": {"type": "string"},
                "paragraph_id": {"type": "string"},
                "page_number": {"type": ["integer", "null"]},
                "quote": {"type": "string", "maxLength": 300}
              }
            }
          },
          "inductive_tags": {
            "type": "array", "maxItems": 8,
            "items": {"type": "string", "maxLength": 80}
          },
          "minimum_response_zh": {"type": "string"},
          "strong_evidence_supplement_zh": {"type": "string"},
          "supported_claims_zh": {"type": "array", "items": {"type": "string"}},
          "unsupported_or_unobserved_claims_zh": {"type": "array", "items": {"type": "string"}},
          "cost_level": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
          "cost_basis_zh": {"type": "string"},
          "stop_conditions_zh": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
